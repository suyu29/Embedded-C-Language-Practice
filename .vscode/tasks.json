{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C: build current file",
            "type": "process",
            "command": "gcc",
            "args": [
                "-std=c11", "-Wall", "-Wextra", "-Wpedantic", "-O0", "-g",
                "-D__USE_MINGW_ANSI_STDIO=1",
                "${file}", "-o", "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "options": {"cwd": "${fileDirname}"},
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": ["$gcc"]
        }
    ]
}
